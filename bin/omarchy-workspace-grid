#!/bin/bash
# KDE-Plasma-style grid workspace navigation for Hyprland.
# Workspaces fill the grid row-major (left to right, row by row):
#   1  2  3
#   4  5  6
# Ctrl+Alt+Arrow  -> switch to the workspace in that grid direction
# + move <dir>    -> move the active window to the neighboring workspace
# COLS/ROWS are tunable via OMARCHY_WS_COLS / OMARCHY_WS_ROWS (defaults 3 / 2).
# Supports Omarchy 4.5+ per-monitor workspace blocks (10 slots per monitor).

set -euo pipefail

SLOTS=10
COLS="${OMARCHY_WS_COLS:-3}"
ROWS="${OMARCHY_WS_ROWS:-2}"
# Clamp at the grid edges (no cross-row jumps). Set OMARCHY_WS_CLAMP=0 to wrap.
CLAMP="${OMARCHY_WS_CLAMP:-1}"
if (( COLS < 1 )); then COLS=3; fi
if (( ROWS < 1 )); then ROWS=2; fi

mode="focus"
dir="${1:-}"
if [[ $1 == "move" ]]; then
  mode="move"
  dir="${2:-}"
fi

case "$dir" in
  left|right|up|down) ;;
  *) echo "usage: omarchy-workspace-grid [move] <left|right|up|down>" >&2; exit 1 ;;
esac

ws_json=$(hyprctl activeworkspace -j 2>/dev/null || echo '{"id":1}')
current=$(jq -r '.id // 1' <<<"$ws_json" 2>/dev/null || echo 1)
[[ $current =~ ^[0-9]+$ ]] || current=1
(( current < 1 )) && current=1

# Block of 10 owned by this monitor (Omarchy 4.5+ per-monitor workspaces)
block=$(( (current - 1) / SLOTS ))
slot=$(( (current - 1) % SLOTS + 1 ))

# Max slots in this grid
grid_max=$(( COLS * ROWS ))
if (( grid_max > SLOTS )); then grid_max=$SLOTS; fi

row=$(( (slot - 1) / COLS ))
col=$(( (slot - 1) % COLS ))

if (( row >= ROWS )); then row=$(( ROWS - 1 )); fi
if (( col >= COLS )); then col=$(( COLS - 1 )); fi

if (( CLAMP )); then
  case "$dir" in
    left)  (( col > 0 )) && col=$((col - 1)) ;;
    right) (( col < COLS - 1 )) && col=$((col + 1)) ;;
    up)    (( row > 0 )) && row=$((row - 1)) ;;
    down)  (( row < ROWS - 1 )) && row=$((row + 1)) ;;
  esac
else
  case "$dir" in
    left)  col=$(( (col + COLS - 1) % COLS )) ;;
    right) col=$(( (col + 1) % COLS )) ;;
    up)    row=$(( (row + ROWS - 1) % ROWS )) ;;
    down)  row=$(( (row + 1) % ROWS )) ;;
  esac
fi

new_slot=$(( row * COLS + col + 1 ))
if (( new_slot > grid_max )); then
  new_slot=$grid_max
fi

next=$(( block * SLOTS + new_slot ))

if [[ ${OMARCHY_WS_DRYRUN:-0} == 1 ]]; then
  echo "$current -> $next"
  exit 0
fi

if [[ $mode == "move" ]]; then
  hyprctl dispatch "o.workspaces.move_window(${new_slot})" >/dev/null 2>&1 || \
  hyprctl dispatch "hl.dsp.window.move({ workspace = \"${next}\" })" >/dev/null
else
  hyprctl dispatch "o.workspaces.focus(${new_slot})" >/dev/null 2>&1 || \
  hyprctl dispatch "hl.dsp.focus({ workspace = \"${next}\" })" >/dev/null
fi
